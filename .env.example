# Runtime
# APP_ENV: process environment name (development | production). Not a venue switch.
APP_ENV=development
# STRATEGY: guardian | trend | swing | maker | offset-maker | liquidity-maker
STRATEGY=guardian
# INSTANCE_ID: instance segment for clientOrderId ownership. Keep short; Binance max 36 chars for newClientOrderId.
INSTANCE_ID=local-01
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# Binance USDT-M credentials (never commit real values)
# BINANCE_API_KEY: API key string. Enable Futures trading only; disable withdrawal; use IP allowlist.
BINANCE_API_KEY=
# BINANCE_API_SECRET: API secret string. Separate testnet and production keys.
BINANCE_API_SECRET=

# Symbol and account mode
# BINANCE_SYMBOL: USDT-M perpetual symbol, e.g. BTCUSDT (not Spot, not _PERP suffix from origin docs)
BINANCE_SYMBOL=BTCUSDT
# BINANCE_TESTNET: true | false. true = testnet. Default path for v1.
BINANCE_TESTNET=true
# BINANCE_MARGIN_MODE: isolated | cross. v1 requires isolated.
BINANCE_MARGIN_MODE=isolated
# BINANCE_LEVERAGE: integer ratio, e.g. 3 = 3x. Must be allowed for the symbol (Binance documents 1–125).
BINANCE_LEVERAGE=3
# BINANCE_REQUIRE_ONE_WAY: true | false. true = refuse or correct Hedge Mode at startup (behavior TBD).
BINANCE_REQUIRE_ONE_WAY=true

# Optional testnet-only custom endpoints. Leave unset to use official URLs resolved at implementation time.
# Must be HTTPS / WSS. Never disable TLS verification.
# BINANCE_REST_URL=
# BINANCE_WS_URL=

# Poll and connection health (all milliseconds)
# ACCOUNT_POLL_MS: REST account backup interval, milliseconds
ACCOUNT_POLL_MS=5000
# ORDERS_POLL_MS: REST open-order backup interval, milliseconds
ORDERS_POLL_MS=3000
# FEED_STALE_MS: max age of a required feed before it is stale, milliseconds
FEED_STALE_MS=10000
# RECONNECT_MAX_MS: WebSocket reconnect backoff cap, milliseconds
RECONNECT_MAX_MS=60000

# Shared trading risk
# TRADE_QUANTITY: order size in base-asset quantity
TRADE_QUANTITY=0.001
# MAX_POSITION_QUANTITY: max abs position in base-asset quantity
MAX_POSITION_QUANTITY=0.002
# MAX_NOTIONAL_USDT: max abs notional in USDT
MAX_NOTIONAL_USDT=200
# MAX_CLOSE_SLIPPAGE_FRACTION: fraction vs mark price; 0.005 = 0.5%
MAX_CLOSE_SLIPPAGE_FRACTION=0.005
# SESSION_LOSS_LIMIT_USDT: session loss limit in USDT
SESSION_LOSS_LIMIT_USDT=10
# KILL_SWITCH_MODE: CANCEL_ONLY | CANCEL_AND_FLATTEN
KILL_SWITCH_MODE=CANCEL_AND_FLATTEN

# Protection / Guardian / Trend
# LOSS_LIMIT_USDT: USD stop distance in USDT (absolute money, not a fraction)
LOSS_LIMIT_USDT=2
# TRAILING_ACTIVATION_PROFIT_USDT: trailing activation profit in USDT
TRAILING_ACTIVATION_PROFIT_USDT=3
# TRAILING_CALLBACK_RATE: Binance callbackRate; 1 = 1%; allowed 0.1–5. Example 0.2 = 0.2%
TRAILING_CALLBACK_RATE=0.2
# PROFIT_LOCK_TRIGGER_USDT: profit (USDT) that starts profit-lock steps
PROFIT_LOCK_TRIGGER_USDT=2
# PROFIT_LOCK_STEP_USDT: profit step width in USDT
PROFIT_LOCK_STEP_USDT=1
# TREND_SMA_PERIOD: SMA lookback in closed candles (count)
TREND_SMA_PERIOD=30
# TREND_KLINE_INTERVAL: Binance kline interval string, e.g. 1m
TREND_KLINE_INTERVAL=1m
# TREND_BOLLINGER_LENGTH: Bollinger lookback in closed candles (count)
TREND_BOLLINGER_LENGTH=20
# TREND_BOLLINGER_MULTIPLIER: dimensionless std multiplier
TREND_BOLLINGER_MULTIPLIER=2
# TREND_MIN_BANDWIDTH: dimensionless minimum Bollinger bandwidth
TREND_MIN_BANDWIDTH=0.001
# TREND_ENTRY_COOLDOWN_MS: cooldown after stop loss before a new entry, milliseconds
TREND_ENTRY_COOLDOWN_MS=60000

# Swing
# SWING_DIRECTION: long | short | both
SWING_DIRECTION=both
# SWING_RSI_PERIOD: RSI lookback in closed candles (count)
SWING_RSI_PERIOD=14
# SWING_RSI_HIGH: RSI threshold, 0–100 scale
SWING_RSI_HIGH=70
# SWING_RSI_LOW: RSI threshold, 0–100 scale; must be < SWING_RSI_HIGH
SWING_RSI_LOW=30
# SWING_SIGNAL_SYMBOL: USDT-M symbol for RSI klines
SWING_SIGNAL_SYMBOL=BTCUSDT
# SWING_SIGNAL_INTERVAL: Binance kline interval string, e.g. 4h
SWING_SIGNAL_INTERVAL=4h
# SWING_SIGNAL_MARKET: usdm (v1). spot is not implemented; do not auto-switch.
SWING_SIGNAL_MARKET=usdm
# SWING_STOP_LOSS_FRACTION: fraction of entry; 0.05 = 5%
SWING_STOP_LOSS_FRACTION=0.05
# SWING_REQUIRE_PROFIT_FOR_EXIT: true | false. When true, RSI signal exit also requires profit condition.
SWING_REQUIRE_PROFIT_FOR_EXIT=true

# Maker family
# MAKER_REFRESH_MS: quote loop interval, milliseconds
MAKER_REFRESH_MS=500
# MAKER_ENTRY_DEPTH_LEVEL: 1-based book level for entry quotes (1 = best)
MAKER_ENTRY_DEPTH_LEVEL=1
# MAKER_BID_OFFSET: subtracted from bid[level] in quote-asset price (USDT). 0 = no extra offset.
MAKER_BID_OFFSET=0
# MAKER_ASK_OFFSET: added to ask[level] in quote-asset price (USDT). 0 = no extra offset.
MAKER_ASK_OFFSET=0
# MAKER_REPRICE_TICKS: min price change in ticks before cancel/replace
MAKER_REPRICE_TICKS=2
# MAKER_MIN_DWELL_MS: min order age before reprice, milliseconds
MAKER_MIN_DWELL_MS=1500
# MAKER_DEPTH_LEVELS: top N book levels for imbalance sums (count)
MAKER_DEPTH_LEVELS=10

# Offset Maker
# OFFSET_SKIP_RATIO: dimensionless. Example 3 = skip the thin entry side when opposite depth * 3 < this side.
OFFSET_SKIP_RATIO=3
# OFFSET_FORCED_EXIT_RATIO: dimensionless. Example 6 = flatten when opposite depth dominates by this ratio.
OFFSET_FORCED_EXIT_RATIO=6

# Liquidity Maker
# LIQUIDITY_SKIP_RATIO: dimensionless skip ratio (no forced imbalance flatten)
LIQUIDITY_SKIP_RATIO=2
# LIQUIDITY_CLOSE_TICK_OFFSET: exit offset in ticks (count)
LIQUIDITY_CLOSE_TICK_OFFSET=1
# LIQUIDITY_RECENT_FILL_MS: max age of a fill price used for exit, milliseconds
LIQUIDITY_RECENT_FILL_MS=60000

# Monetary examples above are placeholders. Resize to capital, symbol, and leverage before any live use.
